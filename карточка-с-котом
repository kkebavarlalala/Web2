<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .card {
            width: 300px;
            border: 1px solid #ccc;
            border-radius: 8px;
            overflow: hidden;
            margin: 20px auto;
        }
        .card-image {
            width: 100%;
            height: auto;
        }
        .card-body {
            padding: 16px;
        }
        .card-title {
            font-size: 1.5em;
            margin: 0 0 8px 0;
        }
        .card-name, .card-age, .card-fac, .card-year {
            margin: 4px 0;
        }
    </style>
</head>
<body>

    <div class="card">
        <img src="my-cat.jpg" alt="Card Image" class="card-image">
        <div class="card-body">
            <h1 class="card-title">MY cat</h1>
            <p class="card-name">NAME: </p>
            <p class="card-age">AGE: </p>
            <p class="card-fac">FACULTY: </p>
            <p class="card-year">YEAR: </p>
        </div>
    </div>

    <script src="main.js">
       


    </script>

    
</body>
</html>
