html {
    height: 100%;
}
body{
    height: 100%;
    margin: 0;
    flex-direction: column;
    background-color: white;
    color:black;
    font-family: Arial, Helvetica, sans-serif;
}

header
{
    background-color: #ddd;
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
nav a{
    text-decoration: none;
    color: black;
    margin-right: 15px;
}
.dark
{
    background-color: #222;
    color:white;
}
.dark header{
    background-color: #111;
}
.dark footer{
    background-color: #111;
}
.dark p{
    color: white;
}
.dark nav a{
    color:white;
}
 main{
    padding: 20px;
 }

