.sidebar {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
}
.wrapper {
  display: flex;
  flex-direction: column;
  min-height: 100vh; 
}

.sidebar button {
    padding: 8px 16px;
    cursor: pointer;
    border: 1px solid #ccc;
    background-color: #f5f5f5;
    border-radius: 4px;
    width: 120px;
    text-align: center;
}

.container {
    display: flex;
    align-items: flex-start;
    flex: 1 0 auto;
}


.foter {
    text-align: center;
    padding: 20px;
    background: #b3b3b3;
    font-family: sans-serif;
    font-size: 14px;
}
