        function Traingle(a, b, c)
        {
            this.a = a
            this.b = b
            this.c = c
        }
        Traingle.prototype.getPerimeter = function()
        {
            return this.a + this.b + this.c
        }

        Traingle.prototype.getArea = function()
        {
            let p = (this.a + this.b + this.c) / 2
            return (p * (p - this.a) * (p - this.b) * (p - this.c)) ** 0.5 
        }
