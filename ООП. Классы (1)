        class Car
        {
            #model
            #year

            constructor(model, year)
            {
                this.#model = model
                this.#year = year
            }

            get Model()
            {
                console.log("get model()")
                return this.#model
            }

            get Year()
            {
                console.log("get year()")
                return this.#year
            }

            set Model(value)
            {
                this.#model = value
            }

            set Year(value)
            {
                if(value < 1900)
                {
                    alert("It might be older")
                }
                else
                {
                    this.#year = value
                }
            }

            getAll()
            {
                console.log("Model " + this.#model)
                console.log("Year " + this.#year)
            }
        }

        let cr1 = new Car("BMW", 2010)

